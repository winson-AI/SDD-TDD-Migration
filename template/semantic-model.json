{
 "_note": "Examples, not evidence: one semantic_model per UI / Logic / Resource item, image checks next to ui_evidence. Platform resources, picture sources and replacements are specified in ui-fidelity.md (精确性纪律 ③, 图片与图标对齐 ④); the UI tree shape in ui-tree-contract.json.",
 "ui_item_example": {
  "semantic_model": {
   "kind": "ui-component-spec",
   "model_ref": {
    "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/ui.component.json",
    "sha256": "{{sha256}}"
   },
   "ui_evidence": {
    "ui_tree_ref": {
     "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/ui-tree.json",
     "sha256": "{{sha256}}"
    },
    "coverage": "settings:base:viewport",
    "visual_mode": "runtime",
    "legacy_executable": true,
    "baseline_refs": [
     {
      "path": "{{absolute-run-root}}/runs/harmony/sandbox/{{capture-agent}}/{{request-id}}/shot.png",
      "sha256": "{{sha256}}"
     }
    ],
    "capture_manifest_ref": {
     "path": "{{absolute-run-root}}/runs/harmony/sandbox/{{capture-agent}}/{{request-id}}/manifest.json",
     "sha256": "{{actual-manifest-sha256}}"
    },
    "source_index_ref": {
     "path": "{{absolute-run-root}}/staging/{{spec-designer}}/{{request-id}}/ui-source-index.json",
     "sha256": "{{actual-source-index-sha256}}"
    },
    "resource_scope": {
     "_note": "Reviewed exclusions, each with reason and evidence_refs: exclusions {source_resource, qualifier, path}, signal_exclusions {signal_id}, usage_exclusions {symbol and/or ref}.",
     "exclusions": [],
     "signal_exclusions": [],
     "usage_exclusions": []
    },
    "runtime_index_ref": {
     "path": "{{absolute-run-root}}/staging/{{spec-designer}}/{{request-id}}/runtime-ui-index.json",
     "sha256": "{{actual-runtime-index-sha256}}"
    }
   },
   "source": {
    "origin": "legacy",
    "locator": "ui/SettingsActivity.java#SettingsAdapter",
    "evidence_refs": []
   },
   "implementation_location": {
    "target_path": "{{absolute-target-root}}/ui/settings/SettingsScreen.kt",
    "symbol": "SettingsScreen"
   }
  }
 },
 "logic_item_example": {
  "semantic_model": {
   "kind": "logic-statechart",
   "model_ref": {
    "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/logic.statechart.json",
    "sha256": "{{sha256}}"
   },
   "source": {
    "origin": "target",
    "locator": "ui/settings/SettingsViewModel.kt",
    "evidence_refs": []
   },
   "implementation_location": {
    "target_path": "{{absolute-target-root}}/ui/settings/SettingsViewModel.kt",
    "symbol": "reducer"
   }
  }
 },
 "resource_item_example": {
  "semantic_model": {
   "kind": "design-tokens",
   "model_ref": {
    "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/tokens.json",
    "sha256": "{{sha256}}"
   },
   "source": {
    "origin": "authored",
    "evidence_refs": []
   },
   "implementation_location": {
    "target_path": "{{absolute-target-root}}/ui/theme/Tokens.kt"
   }
  }
 },
 "image_checks_example": {
  "_note": "kind is image (default: the node shows this legacy picture), text (the node shows this legacy string) or node (the node is there); fields, selectors and tolerances in ui-fidelity.md 图片与图标对齐 ①; every still picture of a node needs a check or a waiver.",
  "image_checks": [
   {
    "id": "settings-back-icon",
    "node_id": "node:settings.toolbar.back",
    "source_resource": "@drawable/ic_back",
    "qualifier": "xxhdpi",
    "reference": {
     "render_ref": {
      "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/reference.json",
      "sha256": "{{actual-reference-json-sha256}}"
     }
    },
    "target": {
     "selector": {
      "resource-id": "{{exact-resource-id-in-the-target-view-tree}}"
     },
     "capture_index": 0
    },
    "tolerance": {
     "shape_iou_min": 0.72
    }
   },
   {
    "id": "settings-title-text",
    "kind": "text",
    "node_id": "node:settings.toolbar.title",
    "source_resource": "@string/settings_title",
    "qualifier": "base",
    "expect": {
     "text": "{{text-the-source-index-holds-for-this-string-and-qualifier}}"
    },
    "target": {
     "selector": {
      "resource-id": "settings.toolbar.title"
     }
    }
   },
   {
    "id": "settings-toolbar-present",
    "kind": "node",
    "node_id": "node:settings.toolbar",
    "target": {
     "selector": {
      "resource-id": "settings.toolbar"
     }
    }
   }
  ],
  "image_check_waivers": [
   {
    "node_id": "node:settings.row.avatar",
    "source_resource": "@drawable/avatar_placeholder",
    "reason": "{{why-this-state-of-the-screen-cannot-show-the-picture}}",
    "evidence_refs": [
     {
      "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/waiver-review.md",
      "sha256": "{{actual-review-sha256}}"
     }
    ]
   }
  ]
 },
 "model_schemas": {
  "ui-component-spec": {
   "root": {
    "type": "Column",
    "props": {},
    "children": [
     {
      "type": "SwitchRow",
      "props": {
       "titleKey": "settings.notifications"
      },
      "bindings": {
       "checked": "state.notificationsEnabled"
      }
     }
    ]
   }
  },
  "logic-statechart": {
   "id": "settings",
   "initial": "idle",
   "states": {
    "idle": {
     "on": {
      "TOGGLE": {
       "target": "saving",
       "cond": {
        "==": [
         {
          "var": "network"
         },
         "online"
        ]
       }
      }
     }
    },
    "saving": {
     "on": {
      "DONE": "idle"
     }
    }
   }
  },
  "design-tokens": {
   "color": {
    "primary": {
     "$type": "color",
     "$value": "#336699"
    }
   },
   "space": {
    "sm": {
     "$type": "dimension",
     "$value": "8px"
    }
   }
  },
  "icu-messages": {
   "settings.notifications": "Notifications",
   "settings.saved": "{count, plural, one {# change saved} other {# changes saved}}"
  }
 }
}
