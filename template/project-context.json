{
  "workspace_root": "{{absolute-migration-workspace}}",
  "package_root": "{{absolute-package-root}}",
  "legacy_root": "{{absolute-legacy-root}}",
  "target_root": "{{absolute-target-root}}",
  "architecture_path": "{{absolute-workspace-root}}/.sdd-migration/inputs/architecture.md",
  "requirements_path": null,
  "test_cases_path": null,
  "project_rules_path": null,
  "test_adapter": {
    "adapters": {
      "android": {"argv": ["{{absolute-python-with-harmony-dependencies}}", "{{package_root}}/skills/migration-test/runtime/harmony/sandbox.py", "test", "--root", "{run_root}", "--config", "{run_root}/runs/harmony/sandbox/environment/config.json", "--env-file", "{run_root}/runs/harmony/sandbox/environment/.env"], "timeout_seconds": 1860},
      "web": {"argv": ["{{absolute-python-with-playwright}}", "{{package_root}}/skills/migration-test/scripts/web_main.py", "--root", "{run_root}", "--config", "{run_root}/runs/harmony/sandbox/environment/web.json"], "timeout_seconds": 600}
    },
    "harmony_reference": {"config": "{{absolute-harmony-reference-config.json}}", "env_file": "{{absolute-harmony-reference-.env}}"},
    "device": {"platforms": ["android", "web"], "android": {"serial": "emulator-5554", "avd": "{{avd-name}}", "app_id": "{{target-application-id}}", "launch": "{{target-launch-activity}}"}, "web": {"url": "{{absolute-url-of-the-served-target}}", "viewport": {"width": 1280, "height": 800}, "record_video": false}}
  },
  "runtime": {
    "model_routing": {
      "strong": {"model": "{{strong-model-id}}", "endpoint": "{{endpoint}}", "api_key": {"env": "SDD_STRONG_MODEL_KEY"}},
      "low_cost": {"model": "{{low-cost-model-id}}", "endpoint": "{{endpoint}}", "api_key": {"env": "SDD_LOW_COST_MODEL_KEY"}},
      "default_tier": "strong",
      "overrides": {}
    }
  },
  "human_owner": null,
  "defaults": {
    "entry_mode": "project",
    "budgets": {
      "max_parallel_modules": 5,
      "max_fix_rounds": 3,
      "max_audit_rounds": 3,
      "max_no_progress_rounds": 2,
      "max_yellow_retries": 2
    },
    "quality_gates": {
      "dependency_resolution_required": false,
      "git_checkpoint": false,
      "fixer_self_diagnosis": false,
      "write_scope_check": false
    }
  },
  "knowledge_paths": [],
  "reference_media": [],
  "legacy_preview": null,
  "scope_statement": null,
  "dependency_changes": null,
  "reuse_sources": [],
  "build": {},
  "target_resources": {},
  "watchdog": {
    "enabled": true,
    "mode": "observe-only",
    "interval_seconds": 60,
    "host_stale_seconds": 180,
    "worker_stall_seconds": 900,
    "check_timeout_seconds": 10
  }
}
