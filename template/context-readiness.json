{
  "schema_version": 1,
  "run_id": "{{run-id}}",
  "module_id": "M001",
  "stage": "{{context.stage}}",
  "producer": {"role": "{{context.producer_role}}", "instance_id": "{{host-bound-instance}}"},
  "subject_sha256": "{{context.subject_sha256}}",
  "draft_ref": "{{global-plan/decompose/plan/audit-plan only: the plan_ref submitted with this report}}",
  "execution": "{{building/testing/audit-testing only: {argv, cwd, environment_ref}}}",
  "refs": {
    "E1": {"path": "{{absolute-evidence-path}}", "sha256": "{{sha256}}"}
  },
  "checks": {
    "{{a-key-of-context.required_checks}}": {
      "status": "ready",
      "summary": "{{what-was-reviewed-and-understood}}",
      "evidence_refs": ["E1"]
    },
    "{{another-key-of-context.required_checks}}": {
      "status": "blocked",
      "summary": "{{what-was-reviewed-and-understood}}",
      "missing": ["{{required-material-or-condition}}"],
      "owner": "{{responsible-role-or-module}}",
      "next_action": "{{how-to-supply-or-resolve}}"
    }
  },
  "verdict": "{{blocked-if-any-check-is-blocked-else-ready}}"
}
