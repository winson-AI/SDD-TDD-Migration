{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "module_id",
    "assignment_id",
    "actor_instance_id",
    "freeze_id",
    "code_baseline"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "implementation",
        "test-design",
        "tests",
        "audit-review"
      ]
    },
    "code_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "paths": {
      "type": "array"
    },
    "input_ref": {"$ref": "#/$defs/ref"},
    "design_ref": {"$ref": "#/$defs/ref"},
    "fix_note_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dimension_evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Required for implementation against a dimension-bound plan; resources additionally require target_resource_ref and consumer_ref.",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "task_ids",
          "summary",
          "evidence_refs"
        ]
      }
    },
    "authoring_diagnostics": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "unavailable"
          ]
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "log_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "version_sensitive_apis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "api",
              "source_ref"
            ],
            "properties": {
              "api": {
                "type": "string",
                "minLength": 1
              },
              "source_ref": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          },
          "then": {
            "required": [
              "tool",
              "log_ref"
            ]
          },
          "else": {
            "required": [
              "reason",
              "version_sensitive_apis"
            ]
          }
        }
      ]
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "test-design"}}},
      "then": {
        "required": ["input_ref", "design_ref", "paths"],
        "properties": {
          "freeze_id": {"type": "null"},
          "code_baseline": {"type": "null"},
          "code_files": {"maxItems": 0},
          "paths": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "implementation"
          }
        }
      },
      "then": {
        "required": [
          "code_files",
          "task_trace",
          "production_binding_evidence",
          "authoring_diagnostics"
        ]
      },
      "else": {
        "required": [
          "paths"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tests"
          }
        }
      },
      "then": {
        "properties": {
          "paths": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "audit-review"
          }
        }
      },
      "then": {
        "required": [
          "paths",
          "snapshot",
          "review_ref",
          "execution_status"
        ],
        "properties": {
          "module_id": {
            "const": "GLOBAL"
          },
          "paths": {
            "maxItems": 0
          },
          "execution_status": {
            "const": "no-retest-needed"
          }
        }
      }
    }
  ]
}
