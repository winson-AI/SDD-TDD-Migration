{
  "schema_version": 1,
  "module_id": "M001",
  "definitions": [
    {
      "kind": "proposal",
      "path": "{{absolute-evidence-path}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "spec",
      "path": "{{absolute-evidence-path}}",
      "sha256": "{{sha256}}",
      "capability": "feature-capability"
    },
    {
      "kind": "design",
      "path": "{{absolute-evidence-path}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "tasks",
      "path": "{{absolute-evidence-path}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "checklist",
      "path": "{{absolute-evidence-path}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "test-design",
      "path": "{{absolute-evidence-path}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "global-contract",
      "path": "{{absolute-evidence-path}}",
      "sha256": "{{sha256}}"
    }
  ],
  "paths": [
    {
      "path_id": "BUILD-M001-001",
      "kind": "build",
      "name": "目标模块编译构建",
      "case_id": "CASE-GLOBAL-001",
      "requirement_id": "REQ-M001-001",
      "required": true,
      "expected_assertions": [
        {
          "assertion_id": "ASSERT-BUILD-M001-EXIT",
          "expected": 0
        }
      ],
      "command": {
        "argv": [
          "/bin/sh",
          "{{absolute-target-root}}/gradlew",
          "{{module-assemble-task}}"
        ],
        "cwd": "{{absolute-target-root}}",
        "timeout_seconds": 900,
        "selection_ref": {
          "path": "{{absolute-build-selection-report}}",
          "sha256": "{{sha256}}"
        }
      }
    },
    {
      "path_id": "PATH-M001-001",
      "name": "{{name}}",
      "case_id": "CASE-GLOBAL-001",
      "requirement_id": "REQ-M001-001",
      "required": true,
      "expected_assertions": [
        {
          "assertion_id": "ASSERT-M001-001",
          "expected": "{{expected-value}}"
        }
      ],
      "kind": "automation"
    }
  ],
  "tasks": [
    {
      "task_id": "TASK-M001-001",
      "requirement_ids": [
        "REQ-M001-001"
      ],
      "path_ids": [
        "BUILD-M001-001",
        "PATH-M001-001"
      ],
      "global_requirement_ids": [
        "REQ-GLOBAL-001"
      ],
      "scope": {
        "in": [
          "{{specific-task-responsibility}}"
        ],
        "out": [
          "{{inherited-submodule-exclusion}}"
        ],
        "write_paths": [
          "{{absolute-task-write-path-within-submodule}}"
        ]
      },
      "dimension_analysis": {
        "scope_sha256": "{{contracts.digest(task.scope)-after-scope-definition}}",
        "parent_ref": {
          "path": "{{absolute-dimension-analysis-path}}",
          "sha256": "{{sha256}}"
        },
        "unresolved": [
          "{{resolve-task-specific-implementation-questions}}"
        ],
        "dimensions": [
          {
            "dimension": "UI",
            "status": "unresolved",
            "reason": "{{analyze-this-task-scope; N/A-requires-evidence-and-empty-item_ids}}",
            "item_ids": [
              "DIM-M001-UI-001"
            ],
            "implementation": "{{concrete-source-fidelity/target-reuse/adaptation/wiring/resource-work-within-task-scope}}",
            "evidence_refs": [
              {
                "path": "{{absolute-task-analysis-evidence-path}}",
                "sha256": "{{sha256}}"
              }
            ]
          },
          {
            "dimension": "Logic",
            "status": "unresolved",
            "reason": "{{analyze-this-task-scope; N/A-requires-evidence-and-empty-item_ids}}",
            "item_ids": [
              "DIM-M001-LOGIC-001"
            ],
            "implementation": "{{concrete-source-fidelity/target-reuse/adaptation/wiring/resource-work-within-task-scope}}",
            "evidence_refs": [
              {
                "path": "{{absolute-task-analysis-evidence-path}}",
                "sha256": "{{sha256}}"
              }
            ]
          },
          {
            "dimension": "Adhesive",
            "status": "unresolved",
            "reason": "{{analyze-this-task-scope; N/A-requires-evidence-and-empty-item_ids}}",
            "item_ids": [
              "DIM-M001-ADHESIVE-001"
            ],
            "implementation": "{{concrete-source-fidelity/target-reuse/adaptation/wiring/resource-work-within-task-scope}}",
            "evidence_refs": [
              {
                "path": "{{absolute-task-analysis-evidence-path}}",
                "sha256": "{{sha256}}"
              }
            ]
          },
          {
            "dimension": "Resource",
            "status": "unresolved",
            "reason": "{{analyze-this-task-scope; N/A-requires-evidence-and-empty-item_ids}}",
            "item_ids": [
              "DIM-M001-RESOURCE-001"
            ],
            "implementation": "{{concrete-source-fidelity/target-reuse/adaptation/wiring/resource-work-within-task-scope}}",
            "evidence_refs": [
              {
                "path": "{{absolute-task-analysis-evidence-path}}",
                "sha256": "{{sha256}}"
              }
            ]
          }
        ]
      }
    }
  ],
  "source_closure": {
    "entry": "{{entry}}",
    "execution_chain": [
      "{{handler}}",
      "{{repository}}"
    ],
    "observable_result": "{{result}}",
    "production_binding": "{{binding}}",
    "evidence_refs": [
      {
        "path": "{{absolute-evidence-path}}",
        "sha256": "{{sha256}}"
      }
    ],
    "unresolved": []
  },
  "target_feasibility": {
    "verdict": "pending",
    "evidence_refs": [
      {
        "path": "{{absolute-evidence-path}}",
        "sha256": "{{sha256}}"
      }
    ]
  },
  "decision_envelope": {
