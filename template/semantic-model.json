  "model_schemas": {
    "ui-component-spec": {
      "root": {
        "type": "Column",
        "props": {},
        "children": [
          {
            "type": "SwitchRow",
            "props": {
              "titleKey": "settings.notifications"
            },
            "bindings": {
              "checked": "state.notificationsEnabled"
            }
          }
        ]
      }
    },
    "logic-statechart": {
      "id": "settings",
      "initial": "idle",
      "states": {
        "idle": {
          "on": {
            "TOGGLE": {
              "target": "saving",
              "cond": {
                "==": [
                  {
                    "var": "network"
                  },
                  "online"
                ]
              }
            }
          }
        },
        "saving": {
          "on": {
            "DONE": "idle"
          }
        }
      }
    },
    "design-tokens": {
      "color": {
        "primary": {
          "$type": "color",
          "$value": "#2AABEE"
        }
      },
      "space": {
        "sm": {
          "$type": "dimension",
          "$value": "8px"
        }
      }
    },
    "icu-messages": {
      "settings.notifications": "Notifications",
      "settings.saved": "{count, plural, one {# change saved} other {# changes saved}}"
    }
  },
