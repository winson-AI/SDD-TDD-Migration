{
  "schema_version": 1,
  "run_id": "{{run-id}}",
  "entry_mode": "project",
  "module_name": null,
  "single_module_id": null,
  "workspace_root": "{{absolute-migration-workspace}}",
  "package_root": "{{absolute-package-root}}",
  "run_root": "{{absolute-migration-workspace}}/.sdd-runs/{{run-id}}",
  "legacy_root": "{{absolute-legacy-root}}",
  "target_root": "{{absolute-target-root}}",
  "project_context_ref": {
    "path": "{{absolute-run-root}}/context/snapshot.json",
    "sha256": "{{sha256}}"
  },
  "new_architecture": {
    "path": "{{absolute-run-root}}/context/files/{{architecture-snapshot}}",
    "sha256": "{{sha256}}"
  },
  "global_spec": {
    "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/{{spec-path}}",
    "sha256": "{{sha256}}"
  },
  "requirement_ids": [
    "REQ-GLOBAL-001"
  ],
  "case_ids": [
    "CASE-GLOBAL-001"
  ],
  "global_paths": [
    {
      "path_id": "PATH-GLOBAL-001",
      "case_id": "CASE-GLOBAL-001",
      "name": "{{integration-name}}",
      "expected_assertions": [
        {
          "assertion_id": "ASSERT-GLOBAL-001",
          "expected": "{{JSON-expected-value}}"
        }
      ],
      "requirement_ids": [
        "REQ-GLOBAL-001"
      ]
    }
  ],
  "test_adapter": {
    "executable": "{{absolute-project-test-adapter}}",
    "args": [],
    "cwd": "{{absolute-target-root}}",
    "query_transport": "query-file",
    "result_format": "migration-test-result",
    "timeout_seconds": 300,
    "environment_ref": "{{absolute-run-root}}/runs/harmony/sandbox/{{request-id}}/environment.json"
  },
  "build": {},
  "reuse_sources": [],
  "module_slicing": {
    "module_import_ref": null,
    "functional_use_cases_complete": false,
    "functional_directory_level": null
  },
  "human_owner": "{{decision-owner}}",
  "escalation_timeout_hours": 24,
  "custom_rules_path": null,
  "git_checkpoint": false,
  "fixer_self_diagnosis": false,
  "write_scope_check": false,
  "dependency_resolution_required": false,
  "max_parallel_modules": 3,
  "max_fix_rounds": 3,
  "max_yellow_retries": 2,
  "max_audit_rounds": 3,
  "max_no_progress_rounds": 2,
  "local_fix_rounds": 1
}
