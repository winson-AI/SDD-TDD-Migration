{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "module_id",
    "assignment_id",
    "actor_instance_id",
    "freeze_id",
    "code_baseline"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "implementation",
        "tests",
        "audit-review"
      ]
    },
    "code_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "paths": {
      "type": "array"
    },
    "fix_note_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "dimension_evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Required for implementation against a dimension-bound plan; resources additionally require target_resource_ref and consumer_ref.",
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "task_ids",
          "summary",
          "evidence_refs"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "implementation"
          }
        }
      },
      "then": {
        "required": [
          "code_files",
          "task_trace",
          "production_binding_evidence"
        ]
      },
      "else": {
        "required": [
          "paths"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tests"
          }
        }
      },
      "then": {
        "properties": {
          "paths": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "audit-review"
          }
        }
      },
      "then": {
        "required": [
          "paths",
          "snapshot",
          "review_ref",
          "execution_status"
        ],
        "properties": {
          "module_id": {
            "const": "GLOBAL"
          },
          "paths": {
            "maxItems": 0
          },
          "execution_status": {
            "const": "no-retest-needed"
          }
        }
      }
    }
  ]
}
