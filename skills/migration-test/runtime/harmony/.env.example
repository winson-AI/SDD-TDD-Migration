# Copy to .env; actual keys must never be committed.
# Same key names and fallback convention as MobileAgenticOperator.
DASHSCOPE_API_KEY=
# Optional role overrides, preferred over DASHSCOPE_API_KEY:
# EXECUTE_MODEL_API_KEY=
# DECISION_MODEL_API_KEY=
# VERIFY_MODEL_API_KEY=
# XMIND_CONVERT_MODEL_API_KEY=

# Explicit Harmony HDC serial; do not reuse an Android emulator serial.
HARMONY_DEVICE=
