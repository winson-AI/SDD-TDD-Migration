      ],
      "assertions": [
        {
          "path_id": "PATH-M001-001",
          "assertion_id": "ASSERT-M001-001"
        }
      ]
    },
    {
      "item_id": "DIM-M001-RESOURCE-001",
      "task_ids": [
        "TASK-M001-001"
      ],
      "path_ids": [
        "PATH-M001-001"
      ],
      "assertions": [
