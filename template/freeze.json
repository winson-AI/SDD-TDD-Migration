    },
    {
      "kind": "design",
      "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/{{design-snapshot}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "tasks",
      "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/{{tasks-snapshot}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "checklist",
      "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/{{checklist-snapshot}}",
      "sha256": "{{sha256}}"
    },
    {
      "kind": "test-design",
      "path": "{{absolute-run-root}}/staging/{{agent}}/{{request-id}}/{{test-design-snapshot}}",
      "sha256": "{{sha256}}"
